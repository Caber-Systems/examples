# Caber public preview settings, read by ./demo.py and docker compose.
# ./demo.py run copies this file to .env.local on first start and fills in the
# generated values. Put your LLM provider key in .env.local, never in this file.

# API key for Anthropic Claude chat completion requests.
# Valid options: A valid Anthropic API key string starting with `sk-ant-`, or leave empty to skip Anthropic.
# Obtain an API key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Anthropic model identifier used for chat completions when Anthropic is selected.
# Valid options: Any Anthropic Claude model ID supported by the OpenAI-compatible `/v1/chat/completions` endpoint (e.g., `claude-sonnet-5-5`, `claude-sonnet-4-20250514`, `claude-3-7-sonnet-latest`, `claude-3-5-haiku-latest`).
ANTHROPIC_MODEL=claude-sonnet-5-5

# API key for NVIDIA NIM (`https://integrate.api.nvidia.com/v1`) chat and embedding requests.
# Valid options: A valid NVIDIA API key starting with `nvapi-`, or leave empty to skip NVIDIA.
# Obtain an API key at: https://build.nvidia.com/ (or https://org.ngc.nvidia.com/setup/api-keys)
NVIDIA_API_KEY=

# NVIDIA NIM chat model identifier used for agent reasoning and chat completions.
# Valid options: Any chat/instruct model hosted on NVIDIA NIM that supports tool calling (e.g., `meta/muse-glimmer-30b`, `meta/llama-3.3-70b-instruct`, `nvidia/llama-3.1-nemotron-70b-instruct`).
NVIDIA_MODEL=meta/muse-glimmer-30b

# NVIDIA NIM text-embedding model identifier used for Milvus semantic indexing and retrieval.
# Valid options: Any embedding model ID on NVIDIA NIM (e.g., `nvidia/nemotron-3-embed-1b`, `nvidia/nv-embedqa-e5-v5`, `nvidia/llama-3.2-nv-embedqa-1b-v2`), or leave empty to disable NVIDIA embeddings.
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# Vector dimension size produced by `NVIDIA_EMBEDDING_MODEL` (verified by live probe at startup).
# Valid options: Positive integer matching the model's output vector length (e.g., `2048` for `nvidia/nemotron-3-embed-1b`, `1024` for `nvidia/nv-embedqa-e5-v5`).
NVIDIA_EMBEDDING_DIM=2048

# API key for Google Gemini (`https://generativelanguage.googleapis.com/v1beta/openai`) chat and embedding requests.
# Valid options: A valid Google AI Studio / Gemini API key string (typically starting with `AIza`), or leave empty to skip Gemini.
# Obtain an API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Google Gemini model identifier used for chat completions and tool calling.
# Valid options: Any Gemini chat model ID (e.g., `gemini-3.8-flash`, `gemini-2.5-pro`, `gemini-2.5-flash`, `gemini-2.0-flash`).
GEMINI_MODEL=gemini-3.8-flash

# Google Gemini text-embedding model identifier used for Milvus semantic search.
# Valid options: Any Gemini embedding model ID (e.g., `gemini-embedding-2`, `text-embedding-004`, `gemini-embedding-exp-03-07`), or leave empty to disable Gemini embeddings.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Vector dimension size produced by `GEMINI_EMBEDDING_MODEL` (verified by live probe at startup).
# Valid options: Positive integer matching the model's output vector length (e.g., `3072` for `gemini-embedding-2`, `768` for `text-embedding-004`).
GEMINI_EMBEDDING_DIM=3072

# API key for OpenAI (`https://api.openai.com/v1`) chat and embedding requests.
# Valid options: A valid OpenAI API key string starting with `sk-`, or leave empty to skip OpenAI.
# Obtain an API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI model identifier used for chat completions and tool calling.
# Valid options: Any OpenAI chat model ID supporting function/tool calling (e.g., `gpt-6-luna`, `gpt-4o`, `gpt-4o-mini`, `gpt-4.1`, `gpt-4.1-mini`).
OPENAI_MODEL=gpt-6-luna

# OpenAI text-embedding model identifier used for Milvus semantic indexing and retrieval.
# Valid options: `text-embedding-3-small`, `text-embedding-3-large`, or `text-embedding-ada-002` (or leave empty to disable OpenAI embeddings).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector dimension size produced by `OPENAI_EMBEDDING_MODEL` (verified by live probe at startup).
# Valid options: Positive integer matching the model's output vector length (`1536` for `text-embedding-3-small` and `text-embedding-ada-002`, `3072` for `text-embedding-3-large`).
OPENAI_EMBEDDING_DIM=1536

# API key for GroqCloud (`https://api.groq.com/openai/v1`) chat completion requests.
# Valid options: A valid Groq API key string starting with `gsk_`, or leave empty to skip Groq.
# Obtain an API key at: https://console.groq.com/keys
GROQ_API_KEY=

# Groq model identifier used for chat completions when Groq is selected.
# Valid options: Any Groq-hosted chat/tool-use model ID (e.g., `openai/gpt-oss-120b`, `llama-3.3-70b-versatile`, `llama-3.1-8b-instant`).
GROQ_MODEL=openai/gpt-oss-120b

# Optional API key used when authenticating to a remote or gated GLiNER2 model endpoint (`CSI_GLINER2_MODEL_URL`) or HuggingFace Hub.
# Valid options: Bearer token / API key string, or leave empty for the unauthenticated local sidecar.
# Obtain a HuggingFace access token at: https://huggingface.co/settings/tokens
CSI_GLINER2_MODEL_API_KEY=

# Generated by demo.py run on first start. Leave empty.
CSI_HMAC_KEY=
CSI_SEED_API_KEY=
CSI_OBJECT_STORE_SECRET=
MOCK_IDP_SCIM_TOKEN=

# Docker container memory hard limit for `caber-core` (prevents host OOM during heavy PDF/OCR parsing).
# Valid options: Docker memory size string with unit suffix (e.g., `4g`, `6g`, `8g`, `16g`).
CABER_CORE_MEM_LIMIT=6g

# Docker container soft memory reservation for `caber-core`.
# Valid options: Docker memory size string with unit suffix (e.g., `512m`, `1g`, `2g`).
CABER_CORE_MEM_RESERVE=1g

# Rust tracing/logging filter level for the `caber-core` service.
# Valid options: Standard Rust `env_logger`/`tracing` directives (`error`, `warn`, `info`, `debug`, `trace`, or module-scoped filters like `info,caber_core=debug`).
RUST_LOG=info

# Root access key (username) for the local S3-compatible object store (`csi-dep-objstor` / VersityGW) used by seed scripts and services.
# Valid options: Any non-empty alphanumeric string (default: `madmin`; must match `OBJSTOR_ROOT_USER`).
MINIO_ROOT_USER=madmin

# AWS/S3 region name used when signing S3 API requests against VersityGW/MinIO or AWS S3.
# Valid options: Any valid AWS region identifier (default: `us-east-1`).
OBJECT_STORE_REGION=us-east-1

# Optional URL overriding the GLiNER2 model inference endpoint inside `caber-core` and `csi-s3-scanner`.
# Valid options: Full HTTP(S) endpoint URL (e.g., `http://host.docker.internal:8765/gliner-2`), or leave empty to auto-resolve from the local sidecar.
CSI_GLINER2_MODEL_URL=

# Maximum number of ReAct tool-calling iterations allowed per user prompt in `agentic-app` before forcing a final answer.
# Valid options: Positive integer (default: `10`).
AGENT_MAX_ITERATIONS=10

# Controls PyCaber SDK global redaction enforcement in `agentic-app` and `mcp-server-back-door` (`demo.py ci agentic-tools` tests both `false` in Stage 4a Observe Mode and `true` in Stage 4b Enforce Mode).
# Valid options: `true` (Enforce Mode: redact unauthorized tool outputs) or `false` (Observe Mode: record audit telemetry without redacting).
CSI_GLOBAL_REDACT_ENABLED=false

# Controls MCP-layer global redaction in `mcp-server-back-door` in tandem with `CSI_GLOBAL_REDACT_ENABLED`.
# Valid options: `true` (redact unauthorized data at the MCP boundary) or `false` (pass through unredacted in Observe Mode).
MCP_GLOBAL_REDACT_ENABLED=false

# Name of the Milvus vector collection populated by `demos/agentic-tools/ingest_milvus.py` and queried by the `search_semantic` MCP tool.
# Valid options: Valid Milvus collection identifier (alphanumeric and underscores, default: `agentic_tools_corpus`).
MILVUS_COLLECTION=agentic_tools_corpus
